# Copy to .env (repo root). Never commit .env.
# macOS (Homebrew Postgres, your login user, no password):
DATABASE_URL=postgresql+psycopg://localhost:5432/everest
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/everest_test
# Windows (official installer, user postgres):
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/everest
# TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/everest_test
# Hosted Postgres (Neon) for development only: use the DIRECT connection string (pooling off),
# start it with postgresql+psycopg:// and end it with ?sslmode=require. The test database must be a
# different database whose name ends in _test, because the tests erase every table in it.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/everest?sslmode=require
# TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/everest_test?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
DEMO_DATA=false
LLM_KEY_SECRET=
